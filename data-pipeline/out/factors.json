    },
    {
      "id": "gini",
      "label": "Income inequality (Gini)",
      "group": "Economic",
      "unit": "index 0-100",
      "direction": "mixed",
      "source": "worldbank"
    },
    {
      "id": "fem_sec_enroll",
      "label": "Female secondary enrolment",
      "group": "Education",
      "unit": "% gross",
      "direction": "negative",
      "source": "worldbank"
    },
    {
      "id": "fem_years_schooling",
      "label": "Female mean years of schooling",
      "group": "Education",
      "unit": "years",
      "direction": "negative",
      "source": "static"
    },
    {
      "id": "flfp",
      "label": "Female labour-force participation",
      "group": "Women's work & agency",
      "unit": "% of women 15+",
      "direction": "negative",
      "source": "worldbank"
    },
    {
      "id": "gii",
      "label": "Gender Inequality Index",
      "group": "Women's work & agency",
      "unit": "index 0-1",
      "direction": "positive",
      "source": "static"
    },
    {
