      "group": "Health & access",
      "unit": "per 1,000 live births",
      "direction": "positive",
      "source": "worldbank"
    },
    {
      "id": "adolescent_fertility",
      "label": "Adolescent birth rate",
      "group": "Health & access",
      "unit": "births per 1,000 women 15-19",
